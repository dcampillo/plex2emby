# Settings for plex2emby. Copy this file to .env and fill in every value:
#
#   cp .env.sample .env
#
# All five are required. .env is gitignored, so never put real keys in this
# sample. Real environment variables take precedence over .env.

# --- Plex (Source Server, read only) ---

# Address of the Plex server. Use the plex.direct hostname from the server's
# certificate so TLS verifies, in this form:
#   https://<ip-with-dashes>.<hash>.plex.direct:32400
PLEX_URL=https://192-168-1-10.0123456789abcdef0123456789abcdef.plex.direct:32400

# Plex authentication token. It decides whose viewing history is read.
# See https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your-plex-token

# --- Emby (Target Server, written to) ---

# Address of the Emby server.
EMBY_URL=https://emby.example.com

# Emby API key, created in the Emby server's settings under API Keys.
EMBY_API_KEY=your-emby-api-key

# Name of the Emby user whose viewing history is updated.
EMBY_USER=your-emby-username
